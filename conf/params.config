params {
    // Reference data
    organism        = null
    census_version  = null
    organ           = "brain"
    ref_collections = null
    ref_keys        = ["subclass", "class", "family", "global"]
    ref_split       = "dataset_title"  // used by get_census_adata; all splits are merged into whole_cortex.h5ad
    subsample_ref   = 100
    relabel_r       = null

    // Query data
    queries_adata         = null
    relabel_q             = null
    subsample_query    = 100   // cells sampled per query file before mapping
    subsample_combined = 1000  // cells sampled from the per-study combined adata for validation
    remove_unknown     = true

    // Batch correction
    batch_correct = true
    batch_keys = [
        "lau": "sample",
        "pineda": "Batch",
        "lim": "batch",
        "velmeshev": "sample",
        "rosmap": "batch",
        "nagy": "batch"
    ]

    // Model / QC params
    cutoff = 0
    seed   = 42
    nmads  = 5
    gene_mapping = "/space/grp/rschwartz/rschwartz/nextflow_eval_pipeline/assets/gemma_genes.tsv"

    // Seurat preprocessing params
    normalization_method = "SCT"
    seurat_dims          = 50
    nfeatures            = 2000

    // Validation analysis params
    n_neighbors     = 15    // kNN k
    umap_n_pcs      = null  // if set, run PCA on obsm["scvi"] before UMAP

    // Output
    outdir = "$projectDir/results/${params.census_version}/${params.organism}"
}
